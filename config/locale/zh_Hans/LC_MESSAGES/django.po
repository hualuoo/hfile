msgid "The WebDAV server's answer doesn't have the file asked for."
msgstr "WebDAV 服务器的回答里没有要找的文件。"

#: apps/storages/drivers/webdav.py
msgid "This WebDAV address isn't a folder."
msgstr "这个 WebDAV 地址不是文件夹。"

