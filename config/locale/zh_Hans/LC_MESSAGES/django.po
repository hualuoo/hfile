msgstr "要用 JSON 发一个列表，每项一个对象。"

#: apps/storages/serializers.py
msgid "A rule id repeats."
msgstr "规则的 id 重复了。"

#: apps/storages/serializers.py
#, python-format
msgid "At most %(limit)s rule of a kind."
msgid_plural "At most %(limit)s rules of a kind."
msgstr[0] "一种规则最多 %(limit)s 条。"

#: apps/storages/serializers.py apps/storages/service.py
msgid "Should be a storage source id."
msgstr "应该是存储源的 id。"

#: apps/storages/serializers.py
msgid "The same storage source appears more than once."
msgstr "同一个存储源出现了不止一次。"

#: apps/storages/serializers.py
#, python-format
