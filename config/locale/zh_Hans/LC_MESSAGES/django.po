msgstr ""
"存储源的类型创建以后不能改：参数和路径换了类型就没有意义了。要换类型，请新建"
"一个存储源。"

#: apps/storages/serializers.py
#, python-format
msgid "A remark is at most %(limit)s character."
msgid_plural "A remark is at most %(limit)s characters."
msgstr[0] "备注最多 %(limit)s 个字。"

#: apps/storages/serializers.py
msgid ""
"This kind of storage has its own download addresses; no download domain is "
"needed."
msgstr "这种存储有自己的下载地址，不用另外设置下载域名。"

#: apps/storages/serializers.py
#, python-format
msgid "A description is at most %(limit)s character."
msgid_plural "A description is at most %(limit)s characters."
msgstr[0] "描述最多 %(limit)s 个字。"

#: apps/storages/serializers.py
msgid "Please fill in the expression."
msgstr "请填写表达式。"

#: apps/storages/serializers.py
msgid ""
"The mode can only be hide only, hide and block access, or hide and block "
"downloads."
msgstr "模式只能是仅隐藏、隐藏并且不可访问、隐藏并且不可下载。"

#: apps/storages/serializers.py
msgid "Please fill in the password."
msgstr "请填写密码。"

#: apps/storages/serializers.py
#, python-format
msgid "The password is at most %(limit)s character."
msgid_plural "The password is at most %(limit)s characters."
msgstr[0] "密码最多 %(limit)s 个字符。"

#: apps/storages/serializers.py
msgid "The path mode can only be relative or absolute."
msgstr "路径模式只能是相对路径或绝对路径。"

#: apps/storages/serializers.py
