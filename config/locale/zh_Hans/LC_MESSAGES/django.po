msgstr "Client ID 不能为空。"

#: apps/sso/validation.py
#, python-format
msgid "Client ID is at most %(limit)s character."
msgid_plural "Client ID is at most %(limit)s characters."
msgstr[0] "Client ID 最多 %(limit)s 个字符。"

