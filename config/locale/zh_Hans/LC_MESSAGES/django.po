#, python-format
msgid ""
"/%(name)s/ is the address of the storage source \"%(storage)s\". Please "
"choose another."
msgstr "/%(name)s/ 是存储源「%(storage)s」的地址，请换一个。"

#: apps/storages/serializers.py
msgid "Please fill in the alias."
msgstr "请填写别名。"

#: apps/storages/serializers.py
#, python-format
msgid "The alias is at most %(limit)s character."
msgid_plural "The alias is at most %(limit)s characters."
msgstr[0] "别名最多 %(limit)s 个字符。"

#: apps/storages/serializers.py
msgid "The alias can only have lowercase letters, digits, - and _."
msgstr "别名只能用小写字母、数字、- 和 _。"

#: apps/storages/serializers.py apps/storages/service.py
