msgid_plural "A readme is at most %(limit)s characters."
msgstr[0] "文档最多 %(limit)s 个字符。"

#: apps/storages/serializers.py
msgid "Please fill in the readme's content."
msgstr "请填写文档的内容。"

#: apps/storages/serializers.py
