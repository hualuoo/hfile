"This program has no MySQL driver (mysqlclient: %(error)s); only SQLite can "
"be chosen."
msgstr "这个程序里没有 MySQL 的驱动（mysqlclient：%(error)s），只能选 SQLite。"

#: apps/installer/service.py
#, python-format
msgid "%(tables)s and others (%(count)s in all)"
msgid_plural "%(tables)s and others (%(count)s in all)"
msgstr[0] "%(tables)s 等 %(count)s 张"

#: apps/installer/service.py
#, python-format
msgid ""
"The database file %(path)s already has another program's tables "
"(%(tables)s). Choose a new file name, so as not to mess up other data."
msgstr ""
"数据库文件 %(path)s 里已经有别的程序的表了（%(tables)s）。请换一个新的文件"
"名，免得弄乱别的数据。"

#: apps/installer/service.py
#, python-format
msgid ""
"The database %(name)s already has another program's tables (%(tables)s). "
"Choose an empty database, so as not to mess up other data."
msgstr ""
"数据库 %(name)s 里已经有别的程序的表了（%(tables)s）。请换一个空的数据库，免"
"得弄乱别的数据。"

#: apps/installer/service.py
#, python-format
msgid ""
"HFile is already installed in the database file %(path)s, with accounts. To "
"go on using it, put the original settings file config.toml back and start "
"again; to install anew, choose a new file name."
msgstr ""
"数据库文件 %(path)s 里已经装好了 HFile，有账号了。要接着用它，把原来的设置文"
"件 config.toml 放回去再启动；要重新安装，请换一个新的文件名。"

#: apps/installer/service.py
#, python-format
msgid ""
"HFile is already installed in the database %(name)s, with accounts. To go on "
"using it, put the original settings file config.toml back and start again; "
"to install anew, choose an empty database."
msgstr ""
"数据库 %(name)s 里已经装好了 HFile，有账号了。要接着用它，把原来的设置文件 "
"config.toml 放回去再启动；要重新安装，请换一个空的数据库。"

#: apps/installer/service.py
#, python-format
msgid ""
"%(path)s isn't an SQLite database file. Choose another file name, so as not "
"to damage it."
msgstr "%(path)s 不是 SQLite 的数据库文件。换一个文件名，免得把它弄坏。"

#: apps/installer/service.py
#, python-format
msgid "The database file %(path)s is in use by another program (%(error)s)."
msgstr "数据库文件 %(path)s 正被别的程序占用（%(error)s）。"

#: apps/installer/service.py
#, python-format
msgid ""
"Can't write the database file %(path)s (%(error)s): check that the file and "
"its folder can be written to."
msgstr ""
"写不了数据库文件 %(path)s（%(error)s）：看看这个文件和它所在的文件夹能不能写"
"入。"

#: apps/installer/service.py
#, python-format
msgid "This path can't be used: %(error)s."
msgstr "用不了这个路径：%(error)s。"

#: apps/installer/service.py
#, python-format
msgid ""
"%(path)s is a folder. Enter the path of the database file, like %(example)s."
msgstr "%(path)s 是一个文件夹。要写数据库文件的路径，比如 %(example)s。"

#: apps/installer/service.py
#, python-format
msgid "Can't create the folder %(folder)s: %(error)s."
msgstr "没法建文件夹 %(folder)s：%(error)s。"

#: apps/installer/service.py
#, python-format
msgid ""
"Can't create the database file in %(folder)s: %(error)s. Choose a folder "
"that can be written to."
msgstr "没法在 %(folder)s 里新建数据库文件：%(error)s。换一个能写入的文件夹。"

#: apps/installer/service.py
#, python-format
msgid ""
"OK: installing will create the database file %(path)s, and its folder "
"%(folder)s."
msgstr "能用：安装时会新建数据库文件 %(path)s，还有它所在的文件夹 %(folder)s。"

#: apps/installer/service.py
#, python-format
msgid "OK: installing will create the database file %(path)s."
msgstr "能用：安装时会新建数据库文件 %(path)s。"

#: apps/installer/service.py
#, python-format
msgid "Created the database file %(path)s, and its folder %(folder)s."
msgstr "新建了数据库文件 %(path)s，还有它所在的文件夹 %(folder)s。"

#: apps/installer/service.py
#, python-format
msgid "Created the database file %(path)s."
msgstr "新建了数据库文件 %(path)s。"

#: apps/installer/service.py
#, python-format
msgid ""
"OK: the database file %(path)s holds an HFile whose install wasn't finished; "
"installing will finish it."
msgstr "能用：数据库文件 %(path)s 里是一个没装完的 HFile，安装会接着装完。"

#: apps/installer/service.py
#, python-format
msgid "OK: the database file %(path)s exists and is empty."
msgstr "能用：数据库文件 %(path)s 已经有了，里面是空的。"

#: apps/installer/service.py
#, python-format
msgid ""
"This is MariaDB (%(version)s): HFile supports only MySQL 8.4 or later. Or "
"choose SQLite."
msgstr ""
"这是 MariaDB（%(version)s）：HFile 只支持 MySQL 8.4 以上，或者选 SQLite。"

#: apps/installer/service.py
#, python-format
msgid "MySQL's version is %(version)s; at least %(minimum)s is needed."
msgstr "MySQL 的版本是 %(version)s，至少要 %(minimum)s。"

#: apps/installer/service.py
#, python-format
msgid "Connected to MySQL %(version)s."
msgstr "连上了 MySQL %(version)s。"

#: apps/installer/service.py
#, python-format
msgid ""
"The user %(user)s has no rights on the database %(name)s: either it doesn't "
"exist yet and this user can't create databases, or it was created for "
"another user. Run this with MySQL's admin account: %(sql)s"
msgstr ""
"用户 %(user)s 没有数据库 %(name)s 的权限：要么这个库还不存在、这个用户又不能"
"建库，要么它是给别的用户建的。请用 MySQL 的管理员账号执行：%(sql)s"

#: apps/installer/service.py
#, python-format
msgid ""
"%(server)s The database %(name)s doesn't exist yet; installing will create "
"it."
msgstr "%(server)s数据库 %(name)s 还没有，安装时会建好它。"

#: apps/installer/service.py
#, python-format
msgid "%(server)s Created the database %(name)s."
msgstr "%(server)s新建了数据库 %(name)s。"

#: apps/installer/service.py
#, python-format
msgid ""
"%(server)s The database %(name)s holds an HFile whose install wasn't "
"finished; installing will finish it."
msgstr "%(server)s数据库 %(name)s 里是一个没装完的 HFile，安装会接着装完。"

#: apps/installer/service.py
#, python-format
msgid "%(server)s The database %(name)s exists and is empty."
msgstr "%(server)s数据库 %(name)s 已经有了，是空的。"

#: apps/installer/service.py
#, python-format
msgid ""
"The character set of the database %(name)s is %(charset)s (%(collation)s); "
"it must be utf8mb4 and case-insensitive. Choose an empty database."
msgstr ""
"数据库 %(name)s 的字符集是 %(charset)s（%(collation)s），要 utf8mb4 并且不区"
"分大小写。请换一个空的数据库。"

#: apps/installer/service.py
#, python-format
msgid ""
"%(found)s Its character set is %(charset)s; installing will change it to "
"utf8mb4."
msgstr "%(found)s它的字符集是 %(charset)s，安装时会改成 utf8mb4。"

#: apps/installer/service.py
#, python-format
msgid ""
"The character set of the database %(name)s is %(charset)s and must become "
"utf8mb4, but the user %(user)s has no right to change it. Run this with "
"MySQL's admin account: %(sql)s"
msgstr ""
"数据库 %(name)s 的字符集是 %(charset)s，要改成 utf8mb4，但用户 %(user)s 没有"
"权限改。请用 MySQL 的管理员账号执行：%(sql)s"

#: apps/installer/service.py
#, python-format
msgid "Creating the tables failed. %(error)s"
msgstr "建表失败。%(error)s"

#: apps/installer/service.py
msgid "This database already has an admin; there's no need to install again."
msgstr "这个数据库里已经有管理员了，不用再安装。"

#: apps/installer/service.py
msgid "The database already has this username. Please choose another."
msgstr "数据库里已经有这个用户名了，请换一个。"

#: apps/installer/templates/installer/_head.html
#: apps/installer/templates/installer/install.html
msgid "Install HFile"
msgstr "安装 HFile"

#: apps/installer/templates/installer/_step_end.html
msgid "Test connection"
msgstr "测试连接"

#: apps/installer/templates/installer/_step_end.html
#: apps/installer/templates/installer/install.html
msgctxt "wizard"
msgid "Back"
msgstr "上一步"

#: apps/installer/templates/installer/_step_end.html
msgid "Next"
msgstr "下一步"

#: apps/installer/templates/installer/done.html
msgid "Installation complete"
msgstr "安装完成"

#: apps/installer/templates/installer/done.html
#, python-format
msgid "The first admin is @%(username)s; log in to the site with it."
msgstr "第一个管理员是 @%(username)s，用它登录网站。"

#: apps/installer/templates/installer/done.html
msgctxt "setup wizard"
msgid "Django admin"
msgstr "后台（Django 管理后台）"

#: apps/installer/templates/installer/done.html
msgid "Settings file"
msgstr "设置文件"

#: apps/installer/templates/installer/done.html
msgid ""
"Note down the address of the Django admin: it is shown here only, once. If "
"you forget it, no matter: once logged in to the site, click \"Django admin\" "
"at the end of the menu on the left of the \"Manage\" page; or look at "
"admin_path in [site] of the settings file."
msgstr ""
"请记下后台的地址，它只在这里显示一次。忘了也不要紧：登录网站后，在「管理」页"
"左边菜单的最后点「后台」；也可以看设置文件里 [site] 的 admin_path。"

#: apps/installer/templates/installer/done.html
msgid ""
"Debug mode is on. Before going live, set debug in [site] of the settings "
"file to false and restart."
msgstr ""
"调试模式开着。正式上线前把设置文件里 [site] 的 debug 改成 false，再重新启动。"

#: apps/installer/templates/installer/done.html
#, python-format
msgid ""
"The database and the admin are created, but the settings file couldn't be "
"written: %(config_problem)s"
msgstr "数据库和管理员都建好了，但设置文件没能写进去：%(config_problem)s"

#: apps/installer/templates/installer/done.html
#, python-format
msgid ""
"Save the text below as <code>%(config_file)s</code> (UTF-8, readable by you "
"only: chmod 600), then restart the program:"
msgstr ""
"请把下面的内容存成 <code>%(config_file)s</code>（UTF-8 编码，只让自己能读："
"chmod 600），再重新启动程序："

#: apps/installer/templates/installer/done.html
msgid "Contents of the settings file"
msgstr "设置文件的内容"

#: apps/installer/templates/installer/done.html
msgid "The program is restarting to read the new settings…"
msgstr "程序正在重新启动，读入新的设置……"

#: apps/installer/templates/installer/done.html
msgid ""
"The settings are saved. Restart the program (stop it and run it again), then "
"open the site."
msgstr "设置已经保存。请重新启动程序（关掉以后再运行一次），然后打开网站。"

#: apps/installer/templates/installer/done.html
msgid ""
"Installed; waiting for the program to restart. If it never does, stop the "
"program and run it again."
msgstr ""
"已经安装好了，正在等程序重新启动。如果一直没有好，请关掉程序再运行一次。"

#: apps/installer/templates/installer/done.html
msgid "Open the site"
msgstr "打开网站"

#: apps/installer/templates/installer/install.html
msgid ""
"The first start: connect to a database and create the first admin. Once "
"installed, this page can't be opened again."
msgstr ""
"第一次启动：连上数据库，建好第一个管理员。装好以后，这个页面就再也打不开了。"

#: apps/installer/templates/installer/install.html
msgid "Some fields need a change; see the ones marked in red below."
msgstr "有几项要改一下，见下面标红的地方。"

#: apps/installer/templates/installer/install.html
msgid "Output while creating the tables"
msgstr "建表时的输出"

#: apps/installer/templates/installer/install.html
msgid "Fields marked <span class=\"required-mark\">*</span> are required."
msgstr "带 <span class=\"required-mark\">*</span> 的必须填写。"

#: apps/installer/templates/installer/install.html
#, python-format
msgid ""
"It proves that it's you installing, not somebody else who opened this page "
"first. %(token_help)s"
msgstr "用来确认是你在安装，而不是别的什么人先打开了这个页面。%(token_help)s"

#: apps/installer/templates/installer/install.html
msgid "Type of database"
msgstr "数据库的类型"

#: apps/installer/templates/installer/install.html
msgid ""
"The data is kept in one file: no database server to install. Good for sites "
"without much traffic."
msgstr "数据存在一个文件里，不用另外装数据库。适合访问量不大的站。"

#: apps/installer/templates/installer/install.html
msgid ""
"Needs MySQL 8.4 or later, installed first. For a lot of traffic and many "
"writes at once."
msgstr "要先装好 MySQL 8.4 以上。访问量大、同时写入多时用它。"

#: apps/installer/templates/installer/install.html
msgid "May include folders, like data/hfile.sqlite3"
msgstr "可以带文件夹，比如 data/hfile.sqlite3"

#: apps/installer/templates/installer/install.html
msgid ""
"A database that doesn't exist is created, which needs a user allowed to "
"create databases; one that exists must have no other tables. \"Test "
"connection\" only reads, it writes nothing."
msgstr ""
"数据库不存在的话会自动创建，这需要用户有建库的权限；已经存在的话，里面不能有"
"别的表。「测试连接」只读不写。"

#: apps/installer/templates/installer/install.html
msgid "127.0.0.1 for this machine"
msgstr "本机就填 127.0.0.1"

#: apps/installer/templates/installer/install.html
msgid "Can be changed later on the Manage page"
msgstr "以后可以在管理页改"

#: apps/installer/templates/installer/install.html
msgid "The address everybody opens the site at"
msgstr "大家打开网站用的地址"

#: apps/installer/templates/installer/install.html
msgid ""
"By default the address you opened this page at (the browser's own, more "
"accurate than what the program sees). Starting with https://, logins go over "
"https only; full direct links and share links use it too."
msgstr ""
"默认是你现在打开这个页面用的地址（浏览器自己的地址，比程序看到的准）。以 "
"https:// 开头时，登录只走 https；直链和分享的完整链接也用它。"

#: apps/installer/templates/installer/install.html
msgid "Separate several with commas"
msgstr "多个用逗号隔开"

#: apps/installer/templates/installer/install.html
msgid ""
"The site answers only at these addresses; 127.0.0.1, localhost and the "
"domain of the site address above are added automatically. If the domain "
"changes later, change allowed_hosts and url in the settings file config.toml."
msgstr ""
"只有用这些地址打开网站才会有回应，127.0.0.1、localhost 和上面网站地址里的域名"
"会自动加上。以后换了域名，改设置文件 config.toml 里的 allowed_hosts 和 url。"

#: apps/installer/templates/installer/install.html
msgid "1 with Nginx or Caddy in front"
msgstr "前面有 Nginx、Caddy 就选 1 层"

#: apps/installer/templates/installer/install.html
msgid ""
"The proxy must pass on Host, X-Forwarded-For and X-Forwarded-Proto: Caddy "
"does by default, Nginx needs proxy_set_header. Too few, and every visitor's "
"IP counts as the proxy's; too many, and visitors can pass for other IPs."
msgstr ""
"代理要把 Host、X-Forwarded-For 和 X-Forwarded-Proto 传过来：Caddy 默认就传，"
"Nginx 要写 proxy_set_header。选少了，访客的 IP 都算成代理的；选多了，访客能冒"
"充别的 IP。"

#: apps/installer/templates/installer/install.html
msgid "May be left empty for a random address of 12 characters"
msgstr "可以留空，自动生成一个 12 位的随机地址"

#: apps/installer/templates/installer/install.html
msgid ""
"Django's own admin isn't at /admin/, where anybody would guess it (that is "
"always a 404), so scanners don't find its login page. English letters, "
"digits, - and _."
msgstr ""
"Django 自带的管理后台不放在人人都猜得到的 /admin/（那里永远是 404），扫描程序"
"就找不到它的登录页。英文字母、数字、- 和 _。"

#: apps/installer/templates/installer/install.html
msgid "The first admin"
msgstr "第一个管理员"

#: apps/installer/templates/installer/install.html
msgid ""
"This account is a superuser: it can open the Manage page and the Django "
"admin."
msgstr "这个账号是超级管理员，可以进管理页和后台。"

#: apps/installer/templates/installer/install.html
msgid "For logging in: letters (Chinese too), digits and @ . + - _"
msgstr "登录用，字母（中文也行）、数字和 @ . + - _"

#: apps/installer/templates/installer/install.html
msgid "At least 8 characters, not too common"
msgstr "至少 8 位，不能太常见"

#: apps/installer/templates/installer/install.html
msgid ""
"Creating the tables and the admin. This takes a few seconds to half a "
"minute; please don't close the page…"
msgstr "正在建表和创建管理员，要几秒到半分钟，请不要关掉页面……"

#: apps/installer/templates/installer/install.html
msgid "Install"
msgstr "开始安装"

#: apps/installer/token.py
#, python-format
msgid ""
"The folder of the settings file (%(folder)s) can't be written to, so the "
"install token can't be saved."
msgstr "设置文件所在的文件夹（%(folder)s）不能写入，安装口令存不了。"

#: apps/installer/token.py
#, python-format
msgid "The install token can't be saved (%(path)s: %(error)s)."
msgstr "安装口令存不了（%(path)s：%(error)s）。"

#: apps/installer/views.py
msgid ""
"It is printed in the command-line window that started the program, and saved "
"in install-token.txt in the folder of the settings file (config.toml)."
msgstr ""
"它打印在启动程序的命令行窗口里，也保存在设置文件（config.toml）所在文件夹的 "
"install-token.txt 里。"

#: apps/installer/views.py
#, python-brace-format
msgid "The install token is wrong. {help}"
msgstr "安装口令不对。{help}"

#: apps/installer/views.py
msgid ""
"The site isn't installed yet: open /install/ first and follow the setup "
"wizard."
msgstr "网站还没有安装：先打开 /install/ 按安装向导填写。"

#: apps/installer/views.py
#, python-format
msgid ""
"%(problem)s HFile can't be installed without it: check this folder, or put "
"the settings file in another folder with --config, and run it again."
msgstr ""
"%(problem)s没有它就安装不了：请检查这个文件夹，或者用 --config 把设置文件放到"
"别的文件夹，再运行。"

#: apps/installer/views.py
#, python-format
msgid ""
"A relative path starts from the folder of the settings file (%(folder)s); "
"missing folders are created. A file that exists must have no other tables."
msgstr ""
"相对路径从设置文件所在的文件夹（%(folder)s）算起，文件夹不存在会自动建好。已"
"经有这个文件的话，里面不能有别的表。"

#: apps/installer/views.py
msgid "Installed already; waiting for the program to restart."
msgstr "已经装好了，正在等程序重新启动。"

#: apps/installer/views.py
msgid "Unknown step to check."
msgstr "不知道要检查哪一步。"

#: apps/ipgeo/jobs.py
msgid "A database is being downloaded. Try again when that is done."
msgstr "正在下载数据库，等它做完再试。"

#: apps/ipgeo/jobs.py
msgid "Locations are being filled in. Try again when that is done."
msgstr "正在补全归属地，等它做完再试。"

#: apps/ipgeo/jobs.py
msgid ""
"It stopped before it was done; the program may have been restarted. It can "
"be started again."
msgstr "没有做完就停了，可能是中途重启了程序。可以重新开始。"

#: apps/ipgeo/jobs.py
#, python-format
msgid "Something went wrong: %(error)s"
msgstr "出错了：%(error)s"

#: apps/ipgeo/jobs.py apps/ipgeo/views.py
msgid "Turn IP location on first."
msgstr "先启用 IP 归属地。"

#: apps/ipgeo/jobs.py
#, python-format
msgid ""
"%(host)s answered %(status)s; the file wasn't downloaded. Try again later."
msgstr "%(host)s 回答 %(status)s，没有拿到文件。请稍后再试。"

#: apps/ipgeo/jobs.py
#, python-format
msgid "no answer in %(seconds)s seconds"
msgstr "%(seconds)s 秒没有回应"

#: apps/ipgeo/jobs.py
#, python-format
msgid "Couldn't connect to %(host)s (%(reason)s). Try again later."
msgstr "连不上 %(host)s（%(reason)s）。请稍后再试。"

#: apps/ipgeo/jobs.py
#, python-format
msgid "The download broke off: no data for %(seconds)s seconds. Try again."
msgstr "下载中断了：%(seconds)s 秒没有收到数据。请重试。"

#: apps/ipgeo/jobs.py
#, python-format
msgid "The download broke off (%(error)s). Try again."
msgstr "下载中断了（%(error)s）。请重试。"

#: apps/ipgeo/jobs.py
#, python-format
msgid ""
"The file is %(size)s MB, over the limit of %(limit)s MB; it wasn't "
"downloaded."
msgstr "文件有 %(size)s MB，超过了 %(limit)s MB 的上限，没有下载。"

#: apps/ipgeo/jobs.py
#, python-format
msgid "The file is over the limit of %(limit)s MB; the download was stopped."
msgstr "文件超过了 %(limit)s MB 的上限，停止下载。"

#: apps/ipgeo/jobs.py
#, python-format
msgid ""
"The download is too slow: not done after %(minutes)s minutes. Try again "
"later."
msgstr "下载太慢，%(minutes)s 分钟还没下完。请稍后再试。"

#: apps/ipgeo/jobs.py
#, python-format
msgid ""
"The download is incomplete: %(got)s bytes came of %(size)s. Please try again."
msgstr "下载不完整：收到 %(got)s 字节，应该有 %(size)s 字节。请重试。"

#: apps/ipgeo/jobs.py
msgctxt "date"
msgid "unknown"
msgstr "未知"

#: apps/ipgeo/jobs.py
#, python-format
msgid "Can't write files in %(folder)s (%(error)s)."
msgstr "不能在 %(folder)s 里写文件（%(error)s）。"

#: apps/ipgeo/jobs.py
#, python-format
msgid "Already up to date (data of %(date)s); nothing changed."
msgstr "已经是最新的了（数据日期 %(date)s），没有变化。"

#: apps/ipgeo/jobs.py
#, python-format
msgid "The downloaded file can't be used: %(problem)s"
msgstr "下载的文件用不了：%(problem)s"

