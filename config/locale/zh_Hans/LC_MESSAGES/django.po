msgstr "要写成 https://域名 这样，以 http:// 或 https:// 开头。"

#: apps/storages/serializers.py
msgid "The address can't have a username, password, ? or #."
msgstr "地址里不能有用户名、密码、? 或 #。"

#: apps/storages/serializers.py
msgid "The address can't contain spaces."
msgstr "地址里不能有空格。"

#: apps/storages/serializers.py
#, python-brace-format
