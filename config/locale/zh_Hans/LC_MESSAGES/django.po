#: config/cli_texts.py
#, python-format
msgid "%r is not callable"
msgstr "%r 不可调用"

#: config/cli_texts.py
#, python-format
msgid "invalid %(type)s value: %(value)r"
msgstr "无效的 %(type)s 值：%(value)r"

#: config/cli_texts.py
#, python-format
msgid "invalid choice: %(value)r (choose from %(choices)s)"
msgstr "无效的选择：%(value)r（可选：%(choices)s）"

#: config/cli_texts.py
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s：错误：%(message)s\n"

#: config/cli_texts.py
msgid "Show program's version number and exit."
msgstr "显示程序的版本号并退出。"

#: config/cli_texts.py
msgid ""
"Verbosity level; 0=minimal output, 1=normal output, 2=verbose output, 3=very "
"verbose output"
msgstr "输出的详细程度：0 = 最少，1 = 正常，2 = 详细，3 = 非常详细"

#: config/cli_texts.py
msgid ""
"The Python path to a settings module, e.g. \"myproject.settings.main\". If "
"this isn't provided, the DJANGO_SETTINGS_MODULE environment variable will be "
"used."
msgstr ""
"设置模块的 Python 路径，比如「myproject.settings.main」。不给时用环境变量 "
"DJANGO_SETTINGS_MODULE。"

#: config/cli_texts.py
msgid ""
"A directory to add to the Python path, e.g. \"/home/djangoprojects/"
"myproject\"."
msgstr "加到 Python 路径里的目录，比如「/home/djangoprojects/myproject」。"

#: config/cli_texts.py
msgid "Display a full stack trace on CommandError exceptions."
msgstr "出现 CommandError 异常时显示完整的调用栈。"

#: config/cli_texts.py
msgid "Don't colorize the command output."
msgstr "命令的输出不加颜色。"

#: config/cli_texts.py
msgid "Force colorization of the command output."
msgstr "命令的输出一定加颜色。"

#: config/cli_texts.py
msgid "Skip system checks."
msgstr "跳过系统检查。"

#: config/cli_texts.py
msgid ""
"Starts a lightweight web server for development and also serves static files."
msgstr "启动一个开发用的轻量网页服务器，同时提供静态文件。"

#: config/cli_texts.py
msgid "Optional port number, or ipaddr:port"
msgstr "可选的端口号，或者「IP 地址:端口」"

#: config/cli_texts.py
msgid "Tells Django to use an IPv6 address."
msgstr "用 IPv6 地址。"

#: config/cli_texts.py
msgid "Tells Django to NOT use threading."
msgstr "不用多线程。"

#: config/cli_texts.py
msgid "Tells Django to NOT use the auto-reloader."
msgstr "不用自动重新加载。"

#: config/cli_texts.py
msgid "Tells Django to NOT automatically serve static files at STATIC_URL."
msgstr "不在 STATIC_URL 自动提供静态文件。"

#: config/cli_texts.py
msgid "Allows serving static files even if DEBUG is False."
msgstr "DEBUG 为 False 时也提供静态文件。"

#: config/cli_texts.py
msgid "Change a user's password for django.contrib.auth."
msgstr "修改 django.contrib.auth 里一个用户的密码。"

#: config/cli_texts.py
msgid "Username to change password for; by default, it's the current username."
msgstr "要改密码的用户名；默认是当前的用户名。"

#: config/cli_texts.py
msgid "Specifies the database to use. Default is \"default\"."
msgstr "指定要用的数据库，默认是「default」。"

#: config/cli_texts.py
msgid "Used to create a superuser."
msgstr "创建一个超级管理员。"

#: config/cli_texts.py
msgid "Specifies the login for the superuser."
msgstr "指定超级管理员的登录名。"

#: config/cli_texts.py
msgid ""
"Tells Django to NOT prompt the user for input of any kind. You must use --"
"username with --noinput, along with an option for any other required field. "
"Superusers created with --noinput will not be able to log in until they're "
"given a valid password."
msgstr ""
"不提示用户输入任何内容。用 --noinput 时必须同时用 --username，以及其他每个必"
"填字段的选项。用 --noinput 创建的超级管理员，要等设了有效的密码才能登录。"

#: config/cli_texts.py
msgid "Deletes stale content types in the database."
msgstr "删除数据库里过时的内容类型。"

#: config/cli_texts.py
msgid "Tells Django to NOT prompt the user for input of any kind."
msgstr "不提示用户输入任何内容。"

#: config/cli_texts.py
msgid "Nominates the database to use. Defaults to the \"default\" database."
msgstr "指定要用的数据库，默认是「default」数据库。"

#: config/cli_texts.py
msgid ""
"Deletes stale content types including ones from previously installed apps "
"that have been removed from INSTALLED_APPS."
msgstr ""
"删除过时的内容类型，包括以前装过、后来从 INSTALLED_APPS 里去掉的应用的。"

#: config/cli_texts.py
msgid ""
"Can be run as a cronjob or directly to clean out expired sessions when the "
"backend supports it."
msgstr ""
"清除过期的会话（会话后端支持时）。可以作为定时任务运行，也可以直接运行。"

#: config/cli_texts.py
msgid "Collect static files in a single location."
msgstr "把静态文件收集到一个地方。"

#: config/cli_texts.py
msgid "Do NOT prompt the user for input of any kind."
msgstr "不提示用户输入任何内容。"

#: config/cli_texts.py
msgid "Do NOT post process collected files."
msgstr "不对收集到的文件做后期处理。"

#: config/cli_texts.py
msgid ""
"Ignore files or directories matching this glob-style pattern. Use multiple "
"times to ignore more."
msgstr "忽略匹配这个通配符模式的文件或目录。可以用多次，忽略更多。"

#: config/cli_texts.py
msgid "Do everything except modify the filesystem."
msgstr "什么都做，只是不改动文件系统。"

#: config/cli_texts.py
msgid ""
"Clear the existing files using the storage before trying to copy or link the "
"original file."
msgstr "复制或链接原文件之前，先用存储清除已有的文件。"

#: config/cli_texts.py
msgid "Create a symbolic link to each file instead of copying."
msgstr "为每个文件创建符号链接，而不是复制。"

#: config/cli_texts.py
msgid ""
"Don't ignore the common private glob-style patterns (defaults to 'CVS', '.*' "
"and '*~')."
msgstr "不忽略常见的私有通配符模式（默认是「CVS」「.*」和「*~」）。"

#: config/cli_texts.py
msgid "Finds the absolute paths for the given static file(s)."
msgstr "找出给定静态文件的绝对路径。"

#: config/cli_texts.py
msgid "Only return the first match for each static file."
msgstr "每个静态文件只返回第一个匹配的。"

#: config/cli_texts.py
msgid "Enter at least one staticfile."
msgstr "至少输入一个静态文件。"

#: config/cli_texts.py
msgid "Checks the entire Django project for potential problems."
msgstr "检查整个 Django 项目里可能的问题。"

#: config/cli_texts.py
msgid "Run only checks labeled with given tag."
msgstr "只运行带有给定标签的检查。"

#: config/cli_texts.py
msgid ""
"List available tags. Specify --deploy to include available deployment tags."
msgstr "列出可用的标签。加上 --deploy 时也列出部署相关的标签。"

#: config/cli_texts.py
msgid "Check deployment settings."
msgstr "检查部署相关的设置。"

#: config/cli_texts.py
msgid ""
"Message level that will cause the command to exit with a non-zero status. "
"Default is ERROR."
msgstr "达到哪个消息级别时命令以非零状态退出，默认是 ERROR。"

#: config/cli_texts.py
msgid "Run database related checks against these aliases."
msgstr "对这些别名的数据库运行数据库相关的检查。"

#: config/cli_texts.py
msgid "Compiles .po files to .mo files for use with builtin gettext support."
msgstr "把 .po 文件编译成 .mo 文件，供内置的 gettext 使用。"

#: config/cli_texts.py
msgid ""
"Locale(s) to process (e.g. de_AT). Default is to process all. Can be used "
"multiple times."
msgstr "要处理的语言区域（比如 de_AT），默认处理全部。可以用多次。"

#: config/cli_texts.py
msgid "Locales to exclude. Default is none. Can be used multiple times."
msgstr "要排除的语言区域，默认不排除。可以用多次。"

#: config/cli_texts.py
msgid "Use fuzzy translations."
msgstr "使用模糊翻译。"

#: config/cli_texts.py
msgid ""
"Ignore directories matching this glob-style pattern. Use multiple times to "
"ignore more."
msgstr "忽略匹配这个通配符模式的目录。可以用多次，忽略更多。"

#: config/cli_texts.py
msgid "Creates the tables needed to use the SQL cache backend."
msgstr "创建 SQL 缓存后端要用的表。"

#: config/cli_texts.py
msgid ""
"Optional table names. Otherwise, settings.CACHES is used to find cache "
"tables."
msgstr "可选的表名。不给时按 settings.CACHES 找缓存表。"

#: config/cli_texts.py
msgid ""
"Nominates a database onto which the cache tables will be installed. Defaults "
"to the \"default\" database."
msgstr "指定在哪个数据库里建缓存表，默认是「default」数据库。"

#: config/cli_texts.py
msgid "Does not create the table, just prints the SQL that would be run."
msgstr "不建表，只打印要运行的 SQL。"

#: config/cli_texts.py
msgid ""
"Runs the command-line client for specified database, or the default database "
"if none is provided."
msgstr "运行指定数据库的命令行客户端，没有指定时用默认数据库。"

#: config/cli_texts.py
msgid ""
"Nominates a database onto which to open a shell. Defaults to the \"default\" "
"database."
msgstr "指定要打开命令行的数据库，默认是「default」数据库。"

#: config/cli_texts.py
msgid "parameters"
msgstr "参数"

#: config/cli_texts.py
msgid ""
"Displays differences between the current settings.py and Django's\n"
"    default settings."
msgstr "显示当前的 settings.py 和 Django 默认设置的区别。"

#: config/cli_texts.py
msgid ""
"Display all settings, regardless of their value. In \"hash\" mode, default "
"values are prefixed by \"###\"."
msgstr ""
"显示所有设置，不管它们的值是什么。在「hash」模式下，默认值前面加「###」。"

#: config/cli_texts.py
msgid ""
"The settings module to compare the current settings against. Leave empty to "
"compare against Django's default settings."
msgstr "拿来和当前设置比较的设置模块。留空时和 Django 的默认设置比较。"

#: config/cli_texts.py
msgid ""
"Selects the output format. 'hash' mode displays each changed setting, with "
"the settings that don't appear in the defaults followed by ###. 'unified' "
"mode prefixes the default setting with a minus sign, followed by the changed "
"setting prefixed with a plus sign."
msgstr ""
"选择输出格式。「hash」模式显示每个改过的设置，默认设置里没有的后面加 ###。"
"「unified」模式先显示带减号的默认设置，再显示带加号的改过的设置。"

#: config/cli_texts.py
msgid ""
"Output the contents of the database as a fixture of the given format (using "
"each model's default manager unless --all is specified)."
msgstr ""
"把数据库的内容按给定格式输出成数据文件；没有指定 --all 时用每个模型的默认管理"
"器。"

#: config/cli_texts.py
msgid ""
"Restricts dumped data to the specified app_label or app_label.ModelName."
msgstr "只导出指定的「应用标签」或「应用标签.模型名」的数据。"

#: config/cli_texts.py
msgid "Specifies the output serialization format for fixtures."
msgstr "指定数据文件的输出序列化格式。"

#: config/cli_texts.py
msgid "Specifies the indent level to use when pretty-printing output."
msgstr "指定美化输出时用的缩进级别。"

#: config/cli_texts.py
msgid ""
"Nominates a specific database to dump fixtures from. Defaults to the "
"\"default\" database."
msgstr "指定从哪个数据库导出数据，默认是「default」数据库。"

#: config/cli_texts.py
msgid ""
"An app_label or app_label.ModelName to exclude (use multiple --exclude to "
"exclude multiple apps/models)."
msgstr ""
"要排除的「应用标签」或「应用标签.模型名」（用多个 --exclude 排除多个应用或模"
"型）。"

#: config/cli_texts.py
msgid "Use natural foreign keys if they are available."
msgstr "有自然外键时用自然外键。"

#: config/cli_texts.py
msgid "Use natural primary keys if they are available."
msgstr "有自然主键时用自然主键。"

#: config/cli_texts.py
msgid ""
"Use Django's base manager to dump all models stored in the database, "
"including those that would otherwise be filtered or modified by a custom "
"manager."
msgstr ""
"用 Django 的基础管理器导出数据库里存的所有模型，包括原本会被自定义管理器过滤"
"或修改掉的。"

#: config/cli_texts.py
msgid ""
"Only dump objects with given primary keys. Accepts a comma-separated list of "
"keys. This option only works when you specify one model."
msgstr "只导出给定主键的对象，主键用逗号分隔。只在指定了一个模型时有用。"

#: config/cli_texts.py
msgid "Specifies file to which the output is written."
msgstr "指定输出写到哪个文件。"

#: config/cli_texts.py
msgid ""
"Removes ALL DATA from the database, including data added during migrations. "
"Does not achieve a \"fresh install\" state."
msgstr ""
"删除数据库里的所有数据，包括迁移时加进去的数据。不会回到「刚安装」的状态。"

#: config/cli_texts.py
msgid "Nominates a database to flush. Defaults to the \"default\" database."
msgstr "指定要清空的数据库，默认是「default」数据库。"

#: config/cli_texts.py
msgid ""
"Introspects the database tables in the given database and outputs a Django "
"model module."
msgstr "检查给定数据库里的表，输出一个 Django 模型模块。"

#: config/cli_texts.py
msgid "Selects what tables or views should be introspected."
msgstr "选择要检查哪些表或视图。"

#: config/cli_texts.py
msgid ""
"Nominates a database to introspect. Defaults to using the \"default\" "
"database."
msgstr "指定要检查的数据库，默认用「default」数据库。"

#: config/cli_texts.py
msgid "Also output models for partition tables."
msgstr "也输出分区表的模型。"

#: config/cli_texts.py
msgid "Also output models for database views."
msgstr "也输出数据库视图的模型。"

#: config/cli_texts.py
msgid "Installs the named fixture(s) in the database."
msgstr "把指定的数据文件装进数据库。"

#: config/cli_texts.py
msgid "Fixture labels."
msgstr "数据文件的标签。"

#: config/cli_texts.py
msgid ""
"Nominates a specific database to load fixtures into. Defaults to the "
"\"default\" database."
msgstr "指定把数据文件装进哪个数据库，默认是「default」数据库。"

#: config/cli_texts.py
msgid "Only look for fixtures in the specified app."
msgstr "只在指定的应用里找数据文件。"

#: config/cli_texts.py
msgid ""
"Ignores entries in the serialized data for fields that do not currently "
"exist on the model."
msgstr "忽略序列化数据里模型现在已经没有的字段。"

#: config/cli_texts.py
msgid ""
"An app_label or app_label.ModelName to exclude. Can be used multiple times."
msgstr "要排除的「应用标签」或「应用标签.模型名」。可以用多次。"

#: config/cli_texts.py
msgid "Format of serialized data when reading from stdin."
msgstr "从标准输入读取时序列化数据的格式。"

#: config/cli_texts.py
msgid ""
"No database fixture specified. Please provide the path of at least one "
"fixture in the command line."
msgstr "没有指定数据文件。请在命令行里给出至少一个数据文件的路径。"

#: config/cli_texts.py
msgid ""
"Runs over the entire source tree of the current directory and pulls out all "
"strings marked for translation. It creates (or updates) a message file in "
"the conf/locale (in the django tree) or locale (for projects and "
"applications) directory.\n"
"\n"
"You must run this command with one of either the --locale, --exclude, or --"
"all options."
msgstr ""
"遍历当前目录下的全部源码，取出所有标记为要翻译的文字，在 conf/locale（Django "
"源码里）或 locale（项目和应用里）目录下创建（或更新）消息文件。\n"
"\n"
"运行这个命令时必须用 --locale、--exclude 或 --all 中的一个选项。"

#: config/cli_texts.py
msgid ""
"Creates or updates the message files for the given locale(s) (e.g. pt_BR). "
"Can be used multiple times."
msgstr "为给定的语言区域（比如 pt_BR）创建或更新消息文件。可以用多次。"

#: config/cli_texts.py
msgid "The domain of the message files (default: \"django\")."
msgstr "消息文件的域（默认：「django」）。"

#: config/cli_texts.py
msgid "Updates the message files for all existing locales."
msgstr "更新所有已有语言区域的消息文件。"

#: config/cli_texts.py
msgid ""
"The file extension(s) to examine (default: \"html,txt,py\", or \"js\" if the "
"domain is \"djangojs\"). Separate multiple extensions with commas, or use -e "
"multiple times."
msgstr ""
"要检查的文件扩展名（默认：「html,txt,py」，域是「djangojs」时是「js」）。多个"
"扩展名用逗号分隔，或者多次用 -e。"

#: config/cli_texts.py
msgid ""
"Follows symlinks to directories when examining source code and templates for "
"translation strings."
msgstr "在源码和模板里找要翻译的文字时，跟着指向目录的符号链接走。"

#: config/cli_texts.py
msgid ""
"Don't ignore the common glob-style patterns 'CVS', '.*', '*~' and '*.pyc'."
msgstr "不忽略常见的通配符模式「CVS」「.*」「*~」和「*.pyc」。"

#: config/cli_texts.py
msgid "Don't break long message lines into several lines."
msgstr "不把长的消息行拆成多行。"

#: config/cli_texts.py
msgid "Don't write '#: filename:line' lines."
msgstr "不写「#: 文件名:行号」这样的行。"

#: config/cli_texts.py
msgid ""
"Controls '#: filename:line' lines. If the option is 'full' (the default if "
"not given), the lines include both file name and line number. If it's "
"'file', the line number is omitted. If it's 'never', the lines are "
"suppressed (same as --no-location). --add-location requires gettext 0.19 or "
"newer."
msgstr ""
"控制「#: 文件名:行号」这样的行。选项是「full」（不给时的默认值）时，行里有文"
"件名和行号；是「file」时省略行号；是「never」时不写这些行（和 --no-location "
"一样）。--add-location 要 gettext 0.19 或更新的版本。"

#: config/cli_texts.py
msgid "Remove obsolete message strings."
msgstr "删除过时的消息。"

#: config/cli_texts.py
msgid "Keep .pot file after making messages. Useful when debugging."
msgstr "生成消息后保留 .pot 文件，调试时有用。"

#: config/cli_texts.py
msgid "Creates new migration(s) for apps."
msgstr "为应用创建新的迁移。"

#: config/cli_texts.py
msgid "Specify the app label(s) to create migrations for."
msgstr "指定要为哪些应用（应用标签）创建迁移。"

#: config/cli_texts.py
msgid "Just show what migrations would be made; don't actually write them."
msgstr "只显示会创建哪些迁移，不真的写出来。"

#: config/cli_texts.py
msgid "Enable fixing of migration conflicts."
msgstr "允许修复迁移冲突。"

#: config/cli_texts.py
msgid "Create an empty migration."
msgstr "创建一个空的迁移。"

#: config/cli_texts.py
msgid "Use this name for migration file(s)."
msgstr "迁移文件用这个名称。"

#: config/cli_texts.py
msgid "Do not add header comments to new migration file(s)."
msgstr "新的迁移文件不加开头的注释。"

#: config/cli_texts.py
msgid ""
"Exit with a non-zero status if model changes are missing migrations and "
"don't actually write them. Implies --dry-run."
msgstr "模型的改动缺少迁移时以非零状态退出，不真的写出迁移。包含 --dry-run。"

#: config/cli_texts.py
msgid ""
"Divert log output and input prompts to stderr, writing only paths of "
"generated migration files to stdout."
msgstr "把日志输出和输入提示改到标准错误，标准输出只写生成的迁移文件的路径。"

#: config/cli_texts.py
msgid ""
"Merge model changes into the latest migration and optimize the resulting "
"operations."
msgstr "把模型的改动合并到最新的迁移里，并优化得到的操作。"

#: config/cli_texts.py
msgid ""
"Updates database schema. Manages both apps with migrations and those without."
msgstr "更新数据库结构。有迁移和没有迁移的应用都管。"

#: config/cli_texts.py
msgid "App label of an application to synchronize the state."
msgstr "要同步状态的应用的标签。"

#: config/cli_texts.py
msgid ""
"Database state will be brought to the state after that migration. Use the "
"name \"zero\" to unapply all migrations."
msgstr "把数据库的状态变成那个迁移之后的状态。用名称「zero」撤销所有迁移。"

#: config/cli_texts.py
msgid ""
"Nominates a database to synchronize. Defaults to the \"default\" database."
msgstr "指定要同步的数据库，默认是「default」数据库。"

#: config/cli_texts.py
msgid "Mark migrations as run without actually running them."
msgstr "把迁移标记为已运行，但不真的运行。"

#: config/cli_texts.py
msgid ""
"Detect if tables already exist and fake-apply initial migrations if so. Make "
"sure that the current database schema matches your initial migration before "
"using this flag. Django will only check for an existing table name."
msgstr ""
"检查表是不是已经存在，存在就假装应用了初始迁移。用这个选项之前，确保当前的数"
"据库结构和初始迁移一致：Django 只检查表名在不在。"

#: config/cli_texts.py
msgid "Shows a list of the migration actions that will be performed."
msgstr "列出将要执行的迁移操作。"

#: config/cli_texts.py
msgid "Creates tables for apps without migrations."
msgstr "为没有迁移的应用创建表。"

#: config/cli_texts.py
msgid ""
"Exits with a non-zero status if unapplied migrations exist and does not "
"actually apply migrations."
msgstr "有没应用的迁移时以非零状态退出，不真的应用迁移。"

#: config/cli_texts.py
msgid "Delete nonexistent migrations from the django_migrations table."
msgstr "从 django_migrations 表里删除已经不存在的迁移。"

#: config/cli_texts.py
msgid "Optimizes the operations for the named migration."
msgstr "优化指定迁移里的操作。"

#: config/cli_texts.py
msgid "App label of the application to optimize the migration for."
msgstr "要优化迁移的应用的标签。"

#: config/cli_texts.py
msgid "Migration name to optimize the operations for."
msgstr "要优化操作的迁移名。"

#: config/cli_texts.py
msgid "Exit with a non-zero status if the migration can be optimized."
msgstr "迁移可以优化时以非零状态退出。"

#: config/cli_texts.py
msgid "Sends a test email to the email addresses specified as arguments."
msgstr "给参数里的邮箱地址发一封测试邮件。"

#: config/cli_texts.py
msgid "One or more email addresses to send a test email to."
msgstr "要发测试邮件的一个或多个邮箱地址。"

#: config/cli_texts.py
msgid "Send a test email to the addresses specified in settings.MANAGERS."
msgstr "给 settings.MANAGERS 里的地址发测试邮件。"

#: config/cli_texts.py
msgid "Send a test email to the addresses specified in settings.ADMINS."
msgstr "给 settings.ADMINS 里的地址发测试邮件。"

#: config/cli_texts.py
msgid ""
"Specify the MAILERS alias to use for sending the test email. Defaults to "
"'default'."
msgstr "指定发测试邮件用的 MAILERS 别名，默认是「default」。"

#: config/cli_texts.py
msgid ""
"You must specify some email recipients, or pass the --managers or --admin "
"options."
msgstr "必须指定收件人，或者用 --managers 或 --admin 选项。"

#: config/cli_texts.py
msgid ""
"Runs a Python interactive interpreter. Tries to use IPython or bpython, if "
"one of them is available. Any standard input is executed as code."
msgstr ""
"运行 Python 交互式解释器。有 IPython 或 bpython 时会先试着用它们。标准输入里"
"的内容都当作代码执行。"

#: config/cli_texts.py
msgid ""
"When using plain Python, ignore the PYTHONSTARTUP environment variable and "
"~/.pythonrc.py script."
msgstr "用普通 Python 时，忽略环境变量 PYTHONSTARTUP 和 ~/.pythonrc.py 脚本。"

#: config/cli_texts.py
msgid "Disable automatic imports of models."
msgstr "不自动导入模型。"

#: config/cli_texts.py
msgid ""
"Specify an interactive interpreter interface. Available options: "
"\"ipython\", \"bpython\", and \"python\""
msgstr "指定交互式解释器。可选：「ipython」「bpython」和「python」"

#: config/cli_texts.py
msgid ""
"Instead of opening an interactive shell, run a command as Django and exit."
msgstr "不打开交互式命令行，而是以 Django 运行一条命令后退出。"

#: config/cli_texts.py
msgid "Shows all available migrations for the current project"
msgstr "显示当前项目的所有迁移"

#: config/cli_texts.py
msgid "App labels of applications to limit the output to."
msgstr "只输出这些应用（应用标签）的。"

#: config/cli_texts.py
msgid ""
"Nominates a database to show migrations for. Defaults to the \"default\" "
"database."
msgstr "指定显示哪个数据库的迁移，默认是「default」数据库。"

#: config/cli_texts.py
msgid ""
"Shows a list of all migrations and which are applied. With a verbosity level "
"of 2 or above, the applied datetimes will be included."
msgstr ""
"列出所有迁移以及哪些已经应用。详细程度为 2 或更高时，也显示应用的时间。"

#: config/cli_texts.py
msgid ""
"Shows all migrations in the order they will be applied. With a verbosity "
"level of 2 or above all direct migration dependencies and reverse "
"dependencies (run_before) will be included."
msgstr ""
"按应用的顺序显示所有迁移。详细程度为 2 或更高时，也显示每个迁移的直接依赖和反"
"向依赖（run_before）。"

#: config/cli_texts.py
msgid ""
"Returns a list of the SQL statements required to return all tables in the "
"database to the state they were in just after they were installed."
msgstr "列出把数据库里所有的表恢复到刚安装时的状态所需的 SQL 语句。"

#: config/cli_texts.py
msgid ""
"Nominates a database to print the SQL for. Defaults to the \"default\" "
"database."
msgstr "指定打印哪个数据库的 SQL，默认是「default」数据库。"

#: config/cli_texts.py
msgid "Prints the SQL statements for the named migration."
msgstr "打印指定迁移的 SQL 语句。"

#: config/cli_texts.py
msgid "App label of the application containing the migration."
msgstr "迁移所在应用的标签。"

#: config/cli_texts.py
msgid "Migration name to print the SQL for."
msgstr "要打印 SQL 的迁移名。"

#: config/cli_texts.py
msgid ""
"Nominates a database to create SQL for. Defaults to the \"default\" database."
msgstr "指定为哪个数据库生成 SQL，默认是「default」数据库。"

#: config/cli_texts.py
msgid "Creates SQL to unapply the migration, rather than to apply it"
msgstr "生成撤销迁移而不是应用迁移的 SQL"

#: config/cli_texts.py
msgid ""
"Prints the SQL statements for resetting sequences for the given app name(s)."
msgstr "打印重置给定应用的序列的 SQL 语句。"

#: config/cli_texts.py
msgid "One or more application label."
msgstr "一个或多个应用标签。"

#: config/cli_texts.py
msgid "Enter at least one application label."
msgstr "至少输入一个应用标签。"

#: config/cli_texts.py
msgid ""
"Squashes an existing set of migrations (from first until specified) into a "
"single new one."
msgstr "把已有的一组迁移（从第一个到指定的那个）压缩成一个新的迁移。"

#: config/cli_texts.py
msgid "App label of the application to squash migrations for."
msgstr "要压缩迁移的应用的标签。"

#: config/cli_texts.py
msgid "Migrations will be squashed starting from and including this migration."
msgstr "从这个迁移（包括它）开始压缩。"

#: config/cli_texts.py
msgid "Migrations will be squashed until and including this migration."
msgstr "压缩到这个迁移（包括它）为止。"

#: config/cli_texts.py
msgid "Do not try to optimize the squashed operations."
msgstr "不尝试优化压缩后的操作。"

#: config/cli_texts.py
msgid "Sets the name of the new squashed migration."
msgstr "设置压缩后新迁移的名称。"

#: config/cli_texts.py
msgid "Do not add a header comment to the new squashed migration."
msgstr "压缩后的新迁移不加开头的注释。"

#: config/cli_texts.py
msgid ""
"Creates a Django app directory structure for the given app name in the "
"current directory or optionally in the given directory."
msgstr ""
"在当前目录（或者给定的目录）里为给定的应用名创建 Django 应用的目录结构。"

#: config/cli_texts.py
msgid "Name of the application or project."
msgstr "应用或项目的名称。"

#: config/cli_texts.py
msgid "Optional destination directory, this will be created if needed."
msgstr "可选的目标目录，需要时会创建。"

#: config/cli_texts.py
msgid "The path or URL to load the template from."
msgstr "从哪个路径或网址加载模板。"

#: config/cli_texts.py
msgid ""
"The file extension(s) to render (default: \"py\"). Separate multiple "
"extensions with commas, or use -e multiple times."
msgstr ""
"要渲染的文件扩展名（默认：「py」）。多个扩展名用逗号分隔，或者多次用 -e。"

#: config/cli_texts.py
msgid ""
"The file name(s) to render. Separate multiple file names with commas, or use "
"-n multiple times."
msgstr "要渲染的文件名。多个文件名用逗号分隔，或者多次用 -n。"

#: config/cli_texts.py
msgid ""
"The directory name(s) to exclude, in addition to .git and __pycache__. Can "
"be used multiple times."
msgstr "除了 .git 和 __pycache__ 以外还要排除的目录名。可以用多次。"

#: config/cli_texts.py
msgid "You must provide an application name."
msgstr "必须给出应用名称。"

#: config/cli_texts.py
msgid ""
"Creates a Django project directory structure for the given project name in "
"the current directory or optionally in the given directory."
msgstr ""
"在当前目录（或者给定的目录）里为给定的项目名创建 Django 项目的目录结构。"

#: config/cli_texts.py
msgid "You must provide a project name."
msgstr "必须给出项目名称。"

#: config/cli_texts.py
msgid ""
"Discover and run tests in the specified modules or the current directory."
msgstr "在指定的模块或当前目录里找出测试并运行。"

#: config/cli_texts.py
msgid ""
"Module paths to test; can be modulename, modulename.TestCase or "
"modulename.TestCase.test_method"
msgstr ""
"要测试的模块路径；可以是「模块名」「模块名.TestCase」或「模块名.TestCase.测试"
"方法」"

#: config/cli_texts.py
msgid ""
"Tells Django to use specified test runner class instead of the one specified "
"by the TEST_RUNNER setting."
msgstr "用指定的测试运行器类，而不是设置 TEST_RUNNER 指定的那个。"

#: config/cli_texts.py
msgid "Stops the test suite after the first failure."
msgstr "第一个失败后就停止测试。"

#: config/cli_texts.py
msgid "Top level of project for unittest discovery."
msgstr "unittest 查找测试时的项目顶层目录。"

#: config/cli_texts.py
msgid "The test matching pattern. Defaults to test*.py."
msgstr "测试文件的匹配模式，默认是 test*.py。"

#: config/cli_texts.py
msgid "Preserves the test DB between runs."
msgstr "两次运行之间保留测试数据库。"

#: config/cli_texts.py
msgid "Shuffles test case order."
msgstr "打乱测试用例的顺序。"

#: config/cli_texts.py
msgid "Reverses test case order."
msgstr "倒过来运行测试用例。"

#: config/cli_texts.py
msgid "Sets settings.DEBUG to True."
msgstr "把 settings.DEBUG 设为 True。"

#: config/cli_texts.py
msgid "Prints logged SQL queries on failure."
msgstr "失败时打印记录下来的 SQL 查询。"

#: config/cli_texts.py
msgid ""
"Run tests using up to N parallel processes. Use the value \"auto\" to run "
"one test process for each processor core."
msgstr ""
"最多用 N 个进程并行运行测试。用值「auto」时每个处理器核心运行一个测试进程。"

#: config/cli_texts.py
msgid "Run only tests with the specified tag. Can be used multiple times."
msgstr "只运行带有指定标签的测试。可以用多次。"

#: config/cli_texts.py
msgid "Do not run tests with the specified tag. Can be used multiple times."
msgstr "不运行带有指定标签的测试。可以用多次。"

#: config/cli_texts.py
msgid "Runs a debugger (pdb, or ipdb if installed) on error or failure."
msgstr "出错或失败时运行调试器（pdb，装了 ipdb 时用 ipdb）。"

#: config/cli_texts.py
msgid "Discard output from passing tests."
msgstr "丢弃通过的测试的输出。"

#: config/cli_texts.py
msgid "Disables the Python faulthandler module during tests."
msgstr "测试时关掉 Python 的 faulthandler 模块。"

#: config/cli_texts.py
msgid "Output timings, including database set up and total run time."
msgstr "输出用时，包括建数据库的时间和总运行时间。"

#: config/cli_texts.py
msgid ""
"Only run test methods and classes that match the pattern or substring. Can "
"be used multiple times. Same as unittest -k option."
msgstr ""
"只运行匹配这个模式或子串的测试方法和类。可以用多次。和 unittest 的 -k 选项一"
"样。"

#: config/cli_texts.py
msgid "Show the N slowest test cases (N=0 for all)."
msgstr "显示最慢的 N 个测试用例（N=0 时显示全部）。"

#: config/cli_texts.py
msgid "Runs a development server with data from the given fixture(s)."
msgstr "用给定数据文件里的数据运行一个开发服务器。"

#: config/cli_texts.py
msgid "Path(s) to fixtures to load before running the server."
msgstr "运行服务器之前要加载的数据文件的路径。"

#: config/cli_texts.py
msgid "Port number or ipaddr:port to run the server on."
msgstr "服务器用的端口号，或者「IP 地址:端口」。"

#: config/cli_texts.py
msgid "Generates configured API schema for project."
msgstr "为项目生成配置好的 API 结构描述。"

