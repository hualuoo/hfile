msgid_plural "At least {min_value} connections."
msgstr[0] "至少 {min_value} 个连接。"

#: apps/storages/serializers.py
#, python-brace-format
msgid "At most {max_value} connection."
msgid_plural "At most {max_value} connections."
msgstr[0] "最多 {max_value} 个连接。"

