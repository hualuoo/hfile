#: apps/storages/grants.py
#, python-format
msgid "Invalid root folder: %(message)s"
msgstr "根目录不对：%(message)s"

#: apps/storages/grants.py
#, python-format
msgid ""
"The root folder is at most %(limit)s character (counting the leading /)."
msgid_plural ""
"The root folder is at most %(limit)s characters (counting the leading /)."
msgstr[0] "根目录最多 %(limit)s 个字符（算上开头的 /）。"

