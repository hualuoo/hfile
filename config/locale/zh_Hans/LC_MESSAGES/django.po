msgstr "复制回调地址"

#: apps/sso/templates/sso/manage/providers.html
msgid ""
"An http(s) or data:image/… address, at most 64 KB; when empty, the name's "
"first letter is shown"
msgstr "http(s) 地址或 data:image/… 地址，最多 64 KB；空着显示名称的第一个字"

#: apps/sso/templates/sso/manage/providers.html
msgid "https://… or data:image/svg+xml;base64,…"
msgstr "https://… 或 data:image/svg+xml;base64,…"

#: apps/sso/templates/sso/manage/providers.html
msgid "Saved encrypted and not shown again"
msgstr "加密保存，保存后不再显示"

#: apps/sso/templates/sso/manage/providers.html
