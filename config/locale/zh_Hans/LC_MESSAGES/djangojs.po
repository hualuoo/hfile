msgstr "要填用户名。"

#: apps/accounts/static/accounts/js/manage_users.js
msgid ""
"User %(username)s created. Next, set their permissions on each storage "
"source."
msgstr "已创建用户 %(username)s。接着设置他在每个存储源上的权限。"

#: apps/accounts/static/accounts/js/manage_users.js
msgid "%(username)s saved."
msgstr "已保存 %(username)s。"

#: apps/accounts/static/accounts/js/manage_users.js
msgid ""
"The basic info, default permissions and storage source permissions have "
"unsaved changes."
msgstr "基本信息、默认权限和存储源权限改了还没保存。"

#: apps/accounts/static/accounts/js/manage_users.js
msgid "The basic info or default permissions have unsaved changes."
msgstr "基本信息或默认权限改了还没保存。"

#: apps/accounts/static/accounts/js/manage_users.js
msgid "The storage source permissions have unsaved changes."
msgstr "存储源权限改了还没保存。"

#: apps/accounts/static/accounts/js/manage_users.js
#: apps/sso/static/sso/js/manage_sso.js
msgid "Discard unsaved changes?"
msgstr "放弃没保存的修改？"

#: apps/accounts/static/accounts/js/manage_users.js
#: apps/sso/static/sso/js/manage_sso.js
msgid "Discard"
msgstr "放弃修改"

#: apps/accounts/static/accounts/js/manage_users.js
msgid ""
"The new user gets the same default permissions, storage source permissions "
"and enabled status as \"%(username)s\"; the password, admin role and two-"
"step verification aren't copied."
msgstr ""
"新用户有和「%(username)s」一样的默认权限和存储源权限，启用状态也一样；不复制"
"密码、管理员身份和两步验证。"

#: apps/accounts/static/accounts/js/manage_users.js
msgid ""
"The new user gets the same default permissions and storage source "
"permissions as \"%(username)s\"; the password, admin role and two-step "
"verification aren't copied."
msgstr ""
"新用户有和「%(username)s」一样的默认权限和存储源权限；不复制密码、管理员身份"
"和两步验证。"

#: apps/accounts/static/accounts/js/manage_users.js
msgid "New username"
msgstr "新用户名"

#: apps/accounts/static/accounts/js/manage_users.js
msgid "New nickname"
msgstr "新昵称"

#: apps/accounts/static/accounts/js/manage_users.js
msgid "Optional"
msgstr "可以不填"

#: apps/accounts/static/accounts/js/manage_users.js
#: apps/web/static/web/js/common.js
msgid "New password"
msgstr "新密码"

#: apps/accounts/static/accounts/js/manage_users.js
msgid "Optional: without it, the new user can't log in with a password for now"
msgstr "可以不填：不填的话，新用户暂时不能用密码登录"

#: apps/accounts/static/accounts/js/manage_users.js
#: apps/accounts/static/accounts/js/totp.js apps/sso/static/sso/js/links.js
#: apps/storages/static/storages/js/manage_storages.js
