#: apps/storages/static/storages/js/manage_storages.js
#: apps/web/static/web/js/common.js
msgid "Cancel"
msgstr "取消"

#: apps/accounts/static/accounts/js/totp.js
msgid "Off"
msgstr "没开"

#: apps/accounts/static/accounts/js/totp.js
msgid "Set up"
msgstr "开始设置"

#: apps/accounts/static/accounts/js/totp.js
msgid "Copy key"
msgstr "复制密钥"

#: apps/accounts/static/accounts/js/totp.js
msgid "Key copied."
msgstr "密钥已复制。"

#: apps/accounts/static/accounts/js/totp.js
msgid "Copying failed. Please type it in."
msgstr "复制失败，请手动输入。"

#: apps/accounts/static/accounts/js/totp.js
msgid ""
"1. Scan this QR code with the authenticator app; if it can't scan, type the "
"key below into the app (choose \"Time based\")."
msgstr ""
"1. 用验证器 App 扫这个二维码；扫不了的话，在 App 里手动输入下面的密钥（选「基"
"于时间」）。"

#: apps/accounts/static/accounts/js/totp.js
msgid "Two-step verification QR code"
msgstr "两步验证的二维码"

#: apps/accounts/static/accounts/js/totp.js
msgid ""
"1. The site name and username are too long for a QR code: type the key below "
"into the authenticator app (choose \"Time based\")."
msgstr ""
"1. 站点名称和用户名太长，二维码装不下：在验证器 App 里手动输入下面的密钥（选"
"「基于时间」）。"

#: apps/accounts/static/accounts/js/totp.js
msgid ""
"2. Enter the 6 digits the app shows for this site now and your login "
"password to turn it on. Valid for 10 minutes."
msgstr ""
"2. 输入 App 里这个网站现在显示的 6 位数字和你的登录密码，确认开启。10 分钟内"
"有效。"

#: apps/accounts/static/accounts/js/totp.js
msgid "6 digits"
msgstr "6 位数字"

#: apps/accounts/static/accounts/js/totp.js
msgid "Verify and turn on"
msgstr "验证并开启"

#: apps/accounts/static/accounts/js/totp.js
msgid "Please enter the 6 digits the app shows."
msgstr "请输入 App 里显示的 6 位数字。"

#: apps/accounts/static/accounts/js/totp.js
msgid "Your login password is required."
msgstr "要填你的登录密码。"

#: apps/accounts/static/accounts/js/totp.js
msgid ""
