msgstr "「%(name)s」添加好了"

#: apps/storages/static/storages/js/manage_storages.js
msgid "\"%(name)s\" is saved but not enabled yet"
msgstr "「%(name)s」已经保存，还没有启用"

#: apps/storages/static/storages/js/manage_storages.js
